[node name="Title" parent="Goodbye/Tab/HBoxContainer" index="1"]
text = "End of Tutorial"

[node name="Text" parent="Goodbye/Backdrop/MarginContainer/VBoxContainer" index="0"]
text = "Congratulations! This marks the conclusion of the tutorial. You are now armed with the knowledge you need to play the game. 
Babel periodically receives updates, and with updated gameplay comes an updated tutorial. So if you ever feel the need to review the tutorial you can access it at the beginning of each game.
And of course, it will (and will always remain) optional.

Now go and enjoy your new game!"

[node name="ChoiceTitle" parent="Goodbye/Backdrop/MarginContainer/VBoxContainer" index="1"]
text = "Page 19 - Final Page"

[node name="Next" parent="Goodbye/Backdrop/MarginContainer/VBoxContainer/Choices" index="2"]
tooltip_text = "Ends the tutorial."
text = "Finish Tutorial"

