[node name="Title" parent="Welcome/Tab/HBoxContainer" index="1"]
text = "Welcome to the Tutorial"

[node name="Text" parent="Welcome/Backdrop/MarginContainer/VBoxContainer" index="0"]
text = "Welcome to Babel's tutorial section. This brief tutorial will teach you the basic mechanics of the game.

Click 'Next' to proceed. Click 'Back' to view previous pages.

You can exit at any time by pressing the red 'X' in the corner. Beware, however: to restart the tutorial, you will have to start a new game."

[node name="ChoiceTitle" parent="Welcome/Backdrop/MarginContainer/VBoxContainer" index="1"]
text = "Page 1 "

[node name="Back" parent="Welcome/Backdrop/MarginContainer/VBoxContainer/Choices" index="0"]
visible = false

[node name="Buffer" parent="Welcome/Backdrop/MarginContainer/VBoxContainer/Choices" index="1"]
