grow_vertical = 2

[node name="Title" parent="Events/Tab/HBoxContainer" index="1"]
text = "Events"

[node name="Text" parent="Events/Backdrop/MarginContainer/VBoxContainer" index="0"]
text = "At the beginning of every turn, there is a small chance for an event to occur. Events appear as small notifications (like the pages of this tutorial) and inflict some sort of effect on the game. Sometimes they can be very beneficial. Other times, they can pose a real threat.

Planning ahead is the smartest choice."

[node name="ChoiceTitle" parent="Events/Backdrop/MarginContainer/VBoxContainer" index="1"]
text = "Page 17"

[node name="Saving" parent="." instance=ExtResource("2_lgwr8")]
