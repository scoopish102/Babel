[node name="Title" parent="Camera/Tab/HBoxContainer" index="1"]
text = "Moving the Camera"

[node name="Text" parent="Camera/Backdrop/MarginContainer/VBoxContainer" index="0"]
text = "To move the camera around, use the WASD or Arrow Keys.

Currently, Babel lacks Mobile controls, but they are being developed and will be released in the near future."

[node name="ChoiceTitle" parent="Camera/Backdrop/MarginContainer/VBoxContainer" index="1"]
text = "Page 2"

[node name="Resources" parent="." instance=ExtResource("2_lgwr8")]
visible = false
