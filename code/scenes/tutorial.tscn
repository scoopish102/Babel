[node name="Title" parent="Saving/Tab/HBoxContainer" index="1"]
text = "Saving the Game"

[node name="Text" parent="Saving/Backdrop/MarginContainer/VBoxContainer" index="0"]
text = "When you're done playing, never forget to save the game! Babel lacks an autosave system, so it's paramount that you remember to save the game every once in a while.
You can access the pause menu either with the button in the top right corner or by pressing the 'Esc' key. In the pause menu, you can save the game, return to the menu, quit to desktop, and resign the game.
Warning: Resigning the game causes you to lose automatically, and losing the game resets your save file, forcing you to start a new game."

[node name="ChoiceTitle" parent="Saving/Backdrop/MarginContainer/VBoxContainer" index="1"]
text = "Page 18"

